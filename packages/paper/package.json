{
  "name": "@someonewithpc/paper",
  "version": "0.1.0",
  "description": "A stack of paper pages you turn by folding the corner, or a book you turn across the spine, with a CSS carousel when scripting is off",
  "license": "GPL-3.0-or-later",
  "author": "Hugo Sales <hugo@hsal.es>",
  "homepage": "https://paper.js.hsal.es",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/someonewithpc/paper.git",
    "directory": "packages/paper"
  },
  "bugs": {
    "url": "https://github.com/someonewithpc/paper/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./adapter": {
      "types": "./dist/adapters/shared.d.ts",
      "default": "./dist/adapters/shared.js"
    },
    "./astro": {
      "types": "./src/astro/index.ts",
      "default": "./src/astro/index.ts"
    },
    "./astro/client": {
      "types": "./dist/astro/client.d.ts",
      "default": "./dist/astro/client.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/element.js",
    "*.css"
  ],
  "keywords": [
    "paper",
    "page-turn",
    "page-flip",
    "book",
    "flipbook",
    "dog-ear",
    "carousel",
    "custom-element",
    "astro-component",
    "astro"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "tsc -p tsconfig.build.json",
    "build:css": "sass --no-source-map --style=expanded src/styles/paper.scss dist/styles.css",
    "clean": "rm -rf dist",
    "check:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css astro",
    "prepack": "npm run clean && npm run build && cp ../../README.md README.md"
  },
  "peerDependencies": {
    "astro": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
