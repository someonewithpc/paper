{
  "name": "paper-workspace",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/paper",
    "packages/react",
    "packages/vue",
    "packages/svelte",
    "packages/solid",
    "packages/astro",
    "site",
    "playground"
  ],
  "scripts": {
    "build": "npm run build -w @someonewithpc/paper && npm run build -w packages/react -w packages/vue -w packages/svelte -w packages/solid -w packages/astro",
    "clean": "npm run clean --workspaces --if-present",
    "pretypecheck": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && svelte-check --tsconfig ./packages/svelte/tsconfig.json --threshold warning && npm run check:astro",
    "check:astro": "astro check --root playground/astro",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:package": "npm run check:package --workspaces --if-present",
    "playground": "node scripts/serve.mjs",
    "site:dev": "npm run build && npm run dev -w site",
    "site:build": "npm run build && npm run build -w site",
    "site:deploy": "npm run site:build && npm run deploy -w site",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@astrojs/check": "^0.9.12",
    "@babel/core": "^7.29.13",
    "@playwright/test": "^1.65.1",
    "@solidjs/babel-plugin": "2.0.2",
    "@solidjs/vite-plugin": "^3.0.1",
    "@solidjs/web": "^2.0.3",
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.12",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "solid-js": "^2.0.3",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "vue": "^3.5.45"
  },
  "engines": {
    "node": ">=20"
  }
}
