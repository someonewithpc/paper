{
  "name": "@someonewithpc/paper",
  "version": "0.1.0",
  "description": "A stack of paper pages you turn by folding the corner, or a book you turn across the spine, with a CSS carousel when scripting is off",
  "license": "GPL-3.0-or-later",
  "author": "Hugo Sales <hugo@hsal.es>",
  "homepage": "https://paper.hsal.es",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/someonewithpc/paper.git"
  },
  "bugs": {
    "url": "https://github.com/someonewithpc/paper/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "workspaces": [
    "site"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "solid": "./dist/solid/index.jsx",
      "worker": "./dist/solid/server.js",
      "deno": "./dist/solid/server.js",
      "browser": "./dist/solid/index.js",
      "node": "./dist/solid/server.js",
      "default": "./dist/solid/index.js"
    },
    "./astro": {
      "types": "./src/astro/index.ts",
      "default": "./src/astro/index.ts"
    },
    "./astro/client": {
      "types": "./dist/astro/client.d.ts",
      "default": "./dist/astro/client.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/element.js",
    "*.css"
  ],
  "keywords": [
    "paper",
    "page-turn",
    "page-flip",
    "book",
    "flipbook",
    "dog-ear",
    "carousel",
    "custom-element",
    "astro-component",
    "react",
    "vue",
    "svelte",
    "solid",
    "astro"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:svelte && npm run build:solid && npm run build:css",
    "build:js": "tsc -p tsconfig.build.json",
    "build:svelte": "svelte-package -i src/svelte -o dist/svelte --tsconfig tsconfig.svelte.json",
    "build:solid": "tsc -p tsconfig.solid.json && node scripts/build-solid.mjs",
    "build:css": "sass --no-source-map --style=expanded src/styles/paper.scss dist/styles.css",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && svelte-check --tsconfig ./tsconfig.svelte.json --threshold warning && npm run check:astro",
    "check:astro": "node scripts/link-self.mjs playground/astro && astro check --root playground/astro",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css astro",
    "playground": "node scripts/serve.mjs",
    "prepack": "npm run clean && npm run build",
    "site:dev": "npm run build && npm run dev -w site",
    "site:build": "npm run build && npm run build -w site",
    "site:deploy": "npm run site:build && npm run deploy -w site"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "solid-js": "^1.8.0",
    "svelte": "^5.0.0",
    "vue": "^3.3.0",
    "astro": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@astrojs/check": "^0.9.12",
    "@babel/core": "^7.29.13",
    "@playwright/test": "^1.65.1",
    "@sveltejs/package": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.12",
    "babel-preset-solid": "^1.9.19",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "solid-js": "^1.9.19",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite-plugin-solid": "^2.11.16",
    "vitest": "^5.1.1",
    "vue": "^3.5.45"
  },
  "engines": {
    "node": ">=20"
  }
}
