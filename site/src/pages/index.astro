---
import Colophon from '../components/Colophon.astro';
import EventTape from '../components/EventTape.astro';
import FoldBook from '../components/FoldBook.astro';
import Frameworks from '../components/Frameworks.astro';
import Hero from '../components/Hero.astro';
import Masthead from '../components/Masthead.astro';
import NoScript from '../components/NoScript.astro';
import Playground from '../components/Playground.astro';
import Restyle from '../components/Restyle.astro';
import Ruler from '../components/Ruler.astro';
import Base from '../layouts/Base.astro';
---

<Base
  title="@someonewithpc/paper: pages you turn by folding the corner"
  description="A JavaScript library for paper pages you turn by folding the corner, as a stack or a book. Components for React, Vue, Svelte, Solid and Astro, and a scroll-snap carousel without JavaScript."
>
  <Ruler />
  <Masthead />
  <main>
    <Hero />
    <FoldBook />
    <Playground>
      <EventTape />
    </Playground>
    <Restyle />
    <Frameworks />
    <NoScript />
  </main>
  <Colophon />
</Base>
