---
import Hero from '../components/Hero.astro';
import Masthead from '../components/Masthead.astro';
import Ruler from '../components/Ruler.astro';
import Base from '../layouts/Base.astro';
---

<Base
  title="@hsal/paper: pages you turn by folding the corner"
  description="A JavaScript library for paper pages you turn by folding the corner, as a stack or a book. Components for React, Vue, Svelte, Solid and Astro, and a scroll-snap carousel without JavaScript."
>
  <Ruler />
  <Masthead />
  <main>
    <Hero />
  </main>
</Base>
