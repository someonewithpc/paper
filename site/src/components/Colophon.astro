---
import { links } from '../lib/links';
---

<footer class="colophon wrap">
  <p class="license">
    <code>@hsal/paper</code> is free software under the <a href={links.license}>GNU General Public License, version 3 or later</a>.
  </p>
  <ul class="links">
    <li><a href={links.github}>Source on GitHub</a></li>
    <li><a href={links.npm}><code>@hsal/paper</code> on npm</a></li>
    <li><a href={links.readme}>README</a></li>
  </ul>
  <p class="byline">Made by <a href={links.author}>Hugo Sales</a>.</p>
</footer>

<style>
  .colophon {
    display: grid;
    gap: 1rem;
    margin-top: clamp(4rem, 2rem + 6vw, 7rem);
    padding-block: 2rem 3rem;
    border-top: 1.5px solid var(--mat-ink-soft);
    font-size: 0.9375rem;
  }

  @media (min-width: 60rem) {
    .colophon {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) auto;
      align-items: start;
      gap: 2rem;
    }
  }

  .license {
    max-width: 30rem;
  }

  .links {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 560;
  }

  .byline {
    color: var(--mat-ink-soft);
  }
</style>
