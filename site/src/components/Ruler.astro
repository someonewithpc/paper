---
const marks = Array.from({ length: 60 }, (_, index) => index + 1);
---

<div class="ruler" aria-hidden="true">
  {marks.map((mark) => <span style={`--cm: ${mark}`}>{mark}</span>)}
</div>

<style>
  .ruler {
    position: relative;
    height: 1.5rem;
    overflow: clip;
    border-bottom: 1px solid var(--mat-line-strong);
    background-image:
      linear-gradient(to right, var(--mat-ink-soft) 1px, transparent 1px),
      linear-gradient(to right, var(--mat-ink-soft) 1px, transparent 1px),
      linear-gradient(to right, var(--mat-line-strong) 1px, transparent 1px);
    background-size: 1cm 0.5rem, 0.5cm 0.3125rem, 1mm 0.1875rem;
    background-position: 0 100%, 0 100%, 0 100%;
    background-repeat: repeat-x;
  }

  span {
    position: absolute;
    top: 0.125rem;
    left: calc(var(--cm) * 1cm);
    translate: -50% 0;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    color: var(--mat-ink-soft);
  }
</style>
